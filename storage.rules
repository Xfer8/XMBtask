rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/images/{allPaths=**} {
      // Any authenticated user can read (needed for cross-user task sharing in future)
      allow read: if request.auth != null;
      // Only the owning user can write/delete their own images
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
